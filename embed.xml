<embed lang="en">
    <title>Ban #{id}</title>

    <color>#992D22</color>

    <group direction="row">
        <line title="Offender:" inline="true">{intruder}</line>
        <line title="Administrator:" inline="true">{admin}</line>
    </group>

    <br />

    <group direction="row">
        <line title="Ban Type:" inline="true">{type}</line>
        <line title="Round ID:" inline="true">{round_id}</line>
        <line title="Server:" inline="true">{server}</line>
    </group>

    <br />

    <group direction="row">
        <line title="Duration:" inline="true">{time_left}</line>
        <line title="Reason:" inline="true">{reason_display}</line>
    </group>

    <br />

    <footer>{admin} • {duration_end}•{date}, {time}</footer>
</embed>

